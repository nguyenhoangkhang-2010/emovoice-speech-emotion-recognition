# Sao chép thành .env rồi chỉnh (không commit .env). Mọi biến đều có giá trị mặc định trong core/config.py.

# --- Cơ sở dữ liệu ---
# PostgreSQL: postgresql+psycopg2://<user>:<mat_khau>@localhost:5432/emovoice
# SQLite (chạy thử nhanh): sqlite:///./emovoice.db
DATABASE_URL=sqlite:///./emovoice.db

# --- Bảo mật ---
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@emovoice.local
ADMIN_PASSWORD=doi-mat-khau-admin-truoc-khi-trien-khai

# --- Âm thanh và mô hình ---
MAX_UPLOAD_MB=10
ALLOWED_AUDIO=wav,mp3
LOW_CONFIDENCE_THRESHOLD=0.30
MODEL_CHECKPOINT_PATH=ml/weights/final_distilhubert_lora_full.pt
# Chỉ cần khi chạy python -m ml.register_model / ml.register_baseline (các tệp .npz không nằm trong git)
EVAL_DATASET_PATH=data/waveforms_cache.npz
EVAL_FEATURES_PATH=

# --- Quên mật khẩu (mã 6 số gửi qua email) ---
PASSWORD_RESET_TTL_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 1 = hiện mã ngay trên giao diện khi chưa có SMTP. CHỈ để demo, không an toàn.
RESET_CODE_ON_SCREEN=0

# --- Chạy ứng dụng ---
SERVER_PORT=7860
# 1 = hiện nút "Vào thử" ở trang đăng nhập (chỉ khi phát triển; kết quả không lưu lịch sử)
DEV_BYPASS_LOGIN=0
# 1 = hiện thêm 2 trang admin: Quản lý mô hình AI, Quản lý dữ liệu âm thanh
ENABLE_ADMIN_EXTRA_PAGES=0
