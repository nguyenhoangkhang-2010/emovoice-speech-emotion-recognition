# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
*.db
*.sqlite3

# Môi trường / bí mật
.env
.env.*
!.env.example

# Dữ liệu chạy (giữ lại .gitkeep)
storage/*/*
!storage/*/.gitkeep
logs/*
!logs/.gitkeep

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tập dữ liệu kiểm thử (quá lớn cho git): đặt tay vào data/
data/*
!data/.gitkeep
